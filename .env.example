# TheDogAPI key — https://thedogapi.com/signup
DOG_API_KEY=

# MotherDuck token (M9 Part B, OPTIONAL) — https://motherduck.com, Settings > Access Tokens.
# Only needed to build/read the CLOUD store (DBT_DUCKDB_PATH=md:dogs, or DOGS_DB=md:dogs for
# the dashboard). Leave blank for the default local-file pipeline. Never commit the real value.
MOTHERDUCK_TOKEN=

# Healthchecks.io URL (OPTIONAL) — https://healthchecks.io
HEALTHCHECKS_URL=